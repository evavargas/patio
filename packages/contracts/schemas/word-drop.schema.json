{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "word-drop.schema.json",
  "title": "WordDropMechanic",
  "type": "object",
  "required": ["type", "schemaVersion", "config"],
  "properties": {
    "type": { "const": "wordDrop" },
    "schemaVersion": { "const": 1 },
    "config": {
      "title": "WordDropConfigV1",
      "type": "object",
      "required": ["template", "blanks", "words"],
      "properties": {
        "template": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Texto con huecos {id}." },
        "blanks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "WordDropBlank",
            "type": "object",
            "required": ["id", "correct"],
            "properties": {
              "id": { "$ref": "primitives.schema.json#/$defs/FieldId" },
              "correct": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        },
        "words": {
          "description": "Banco de palabras, incluye las correctas y distractores.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    }
  }
}
