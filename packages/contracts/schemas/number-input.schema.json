{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "number-input.schema.json",
  "title": "NumberInputMechanic",
  "type": "object",
  "required": ["type", "schemaVersion", "config"],
  "properties": {
    "type": { "const": "numberInput" },
    "schemaVersion": { "const": 1 },
    "config": {
      "title": "NumberInputConfigV1",
      "type": "object",
      "required": ["expression", "fields"],
      "properties": {
        "expression": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Texto con huecos {id}." },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "NumberInputField",
            "type": "object",
            "required": ["id", "expected"],
            "properties": {
              "id": { "$ref": "primitives.schema.json#/$defs/FieldId" },
              "expected": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
