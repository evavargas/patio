{
  "name": "@patio/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && NODE_ENV=development node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "create-admin": "pnpm build && node dist/accounts/create-admin.js",
    "test": "vitest run",
    "lint": "eslint .",
    "seed": "pnpm build && NODE_ENV=development node dist/seed/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@patio/contracts": "workspace:*",
    "mongodb": "7.8.0",
    "nodemailer": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
