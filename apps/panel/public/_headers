# Cloudflare Pages. CSP estricta: sin scripts en linea. Reemplazar API_ORIGIN por el origen real de la API.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' API_ORIGIN; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
